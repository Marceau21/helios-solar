# --- Mode démo ---
# true = aucune clé requise, données de démonstration clairement étiquetées "DÉMO"
NEXT_PUBLIC_DEMO_MODE=true

# --- Supabase (https://supabase.com > Project settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Solar API + Geocoding (console.cloud.google.com) ---
GOOGLE_MAPS_API_KEY=

# --- Chiffrement des identifiants fabricants (32 octets en base64) ---
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# --- Enphase (developer-v4.enphase.com) ---
ENPHASE_CLIENT_ID=
ENPHASE_CLIENT_SECRET=
ENPHASE_API_KEY=

# --- Protection de la route de synchronisation planifiée ---
CRON_SECRET=
